# Root-level env — variables docker-compose itself reads (container ports,
# credentials for the local-only Postgres/Redis containers). Real per-app
# runtime config lives in each app's own .env (apps/backend/.env.example,
# apps/owner-app/.env.example). Never commit a filled-in .env anywhere in
# this repo — production values come from the secrets manager, not files
# (Constitution V.3).

POSTGRES_USER=morbeez
POSTGRES_PASSWORD=morbeez_dev_only
POSTGRES_DB=morbeez
POSTGRES_PORT=5432

# The application's own, restricted database role — created by the
# create-app-runtime-role migration, not by Postgres init scripts, since it
# needs to exist before it can be granted privileges on tables that don't
# exist until other migrations run. Picked up from process.env by that
# migration directly (node-pg-migrate is plain Node); also used by
# docker-compose to build the backend/worker containers' APP_DATABASE_URL.
APP_DB_PASSWORD=morbeez_app_dev_only

REDIS_PORT=6379

BACKEND_PORT=3000
