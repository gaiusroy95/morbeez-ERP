{
  "name": "morbeez",
  "version": "0.0.0",
  "private": true,
  "description": "Morbeez ERP — multi-tenant SaaS for vegetable wholesalers. Monorepo root.",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "docker:up": "docker compose up -d postgres redis",
    "docker:down": "docker compose down",
    "db:migrate": "pnpm --filter @morbeez/backend migrate:up",
    "db:migrate:down": "pnpm --filter @morbeez/backend migrate:down",
    "db:seed": "pnpm --filter @morbeez/backend seed"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "ts-node": "^10.9.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.14.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.0.0"
}
