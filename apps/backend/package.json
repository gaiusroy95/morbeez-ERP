{
  "name": "@morbeez/backend",
  "version": "0.0.0",
  "private": true,
  "description": "Morbeez ERP backend — NestJS modular monolith. Framework foundation (config, database, logging, error handling, validation, API docs, health checks) implemented; bounded-context business modules not yet built.",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:worker": "ts-node worker/main.ts",
    "test": "jest",
    "test:integration": "jest --config ./test/jest-integration.json --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "lint": "eslint \"src/**/*.ts\"",
    "migrate:up": "node-pg-migrate --migration-file-language js --migrations-dir ../../database/migrations up",
    "migrate:down": "node-pg-migrate --migration-file-language js --migrations-dir ../../database/migrations down",
    "migrate:create": "node-pg-migrate --migration-file-language js --migrations-dir ../../database/migrations create",
    "seed": "ts-node ../../database/seeds/run.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/terminus": "^10.2.0",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.0",
    "nestjs-pino": "^4.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.12.0",
    "pino-http": "^10.1.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.11.0",
    "jest": "^29.7.0",
    "node-pg-migrate": "^7.6.0",
    "pino-pretty": "^11.2.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.4.0"
  },
  "jest": {
    "rootDir": "src",
    "testRegex": ".spec.ts$",
    "transform": { "^.+\\.(t|j)s$": "ts-jest" },
    "moduleFileExtensions": ["js", "json", "ts"],
    "collectCoverageFrom": ["**/*.(t|j)s"],
    "coverageDirectory": "../coverage"
  }
}
