{
  "name": "@morbeez/backend",
  "version": "0.0.0",
  "private": true,
  "description": "Morbeez ERP backend — NestJS modular monolith. Structure only; see docs/architecture and docs/domain-model.",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:worker": "ts-node worker/main.ts",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "lint": "eslint \"src/**/*.ts\"",
    "migrate:up": "node-pg-migrate --migration-file-language js --migrations-dir ../../database/migrations up",
    "migrate:down": "node-pg-migrate --migration-file-language js --migrations-dir ../../database/migrations down",
    "migrate:create": "node-pg-migrate --migration-file-language js --migrations-dir ../../database/migrations create",
    "seed": "ts-node ../../database/seeds/run.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "jest": "^29.7.0",
    "node-pg-migrate": "^7.6.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.4.0"
  }
}
