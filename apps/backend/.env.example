# Copy to .env for local development. Validated at boot by
# src/config/env.validation.ts — the process refuses to start if a required
# variable is missing or malformed, rather than failing confusingly later.

NODE_ENV=development
PORT=3000

# Two different roles, on purpose (database/migrations,
# create-app-runtime-role). DATABASE_URL is the owner — DDL only, used by
# `pnpm db:migrate`/`pnpm db:seed`, never by this running process.
# APP_DATABASE_URL is what the app actually connects with: DML-only,
# genuinely subject to Row-Level Security. Both point at the same local
# Postgres when running the backend directly on the host against
# `docker compose up postgres redis`.
DATABASE_URL=postgres://morbeez:morbeez_dev_only@localhost:5432/morbeez
APP_DATABASE_URL=postgres://morbeez_app:morbeez_app_dev_only@localhost:5432/morbeez
REDIS_URL=redis://localhost:6379

# Local dev only — a real secret comes from the secrets manager in every
# other environment (Constitution V.3).
JWT_SECRET=dev_only_change_me
FIELD_ENCRYPTION_KEY=dev_only_change_me_too_1234

# Local event bus (docker-compose does not run one yet — see System
# Architecture, EVT.2, for the target: Amazon MSK Serverless / Kafka
# protocol). Leave unset until that service is added to docker-compose.
EVENT_BUS_BROKERS=

LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:3001
API_DOCS_ENABLED=true
DATABASE_POOL_MAX=10

# Rate limits (Security Audit SA-02). TRUST_PROXY names the hops allowed to
# report the client's address through X-Forwarded-For: the owner app's
# server locally; add the load balancer in production.
TRUST_PROXY=loopback
LOGIN_ATTEMPTS_PER_IP_PER_MINUTE=60
TENANT_RATE_LIMIT_PER_MINUTE=1200
