# Copy to .env for local development. Validated at boot by
# src/config/env.validation.ts — the process refuses to start if a required
# variable is missing or malformed, rather than failing confusingly later.
#
# Contents
#   1. Core — required: the API doesn't start without these
#   2. Core — optional, with working defaults
#   3. Photo storage (S3) — optional
#   4. Outside services (APIs to sign up for) — all optional:
#        4a. PUBLIC_API_URL  — needed by WhatsApp and calls
#        4b. WhatsApp Cloud API (Meta) — order messages from customers
#        4c. Claude (Anthropic) — reads the order out of each message
#        4d. Twilio — automated calls to customers
#   5. Testing only — leave unset
#   6. The other apps' settings
#
# Leaving a service in section 4 unset turns just that feature off; Settings →
# Integrations in the owner app shows what is on and what is missing.

# ============================================================================
# 1. Core — required
# ============================================================================

NODE_ENV=development
PORT=3000

# Two different roles, on purpose (database/migrations,
# create-app-runtime-role). DATABASE_URL is the owner — DDL only, used by
# `pnpm db:migrate`/`pnpm db:seed`, never by this running process.
# APP_DATABASE_URL is what the app actually connects with: DML-only,
# genuinely subject to Row-Level Security. Both point at the same local
# Postgres when running the backend directly on the host against
# `docker compose up postgres redis`.
DATABASE_URL=postgres://morbeez:morbeez_dev_only@localhost:5432/morbeez
APP_DATABASE_URL=postgres://morbeez_app:morbeez_app_dev_only@localhost:5432/morbeez
REDIS_URL=redis://localhost:6379

# Local dev only — a real secret comes from the secrets manager in every
# other environment (Constitution V.3). At least 16 characters each.
JWT_SECRET=dev_only_change_me
FIELD_ENCRYPTION_KEY=dev_only_change_me_too_1234

# ============================================================================
# 2. Core — optional, with working defaults
# ============================================================================

# Local event bus (docker-compose does not run one yet — see System
# Architecture, EVT.2, for the target: Amazon MSK Serverless / Kafka
# protocol). Leave unset until that service is added to docker-compose.
EVENT_BUS_BROKERS=

LOG_LEVEL=debug
# Required in production: the owner app's address(es), comma-separated.
CORS_ORIGIN=http://localhost:3001
API_DOCS_ENABLED=true
DATABASE_POOL_MAX=10

# The owner app's public address, for links the API hands out (a worker's
# password set-up link). Unset: the first CORS_ORIGIN.
# PUBLIC_APP_URL=https://app.example.com

# Rate limits (Security Audit SA-02). TRUST_PROXY names the hops allowed to
# report the client's address through X-Forwarded-For: the owner app's
# server locally; add the load balancer in production.
TRUST_PROXY=loopback
LOGIN_ATTEMPTS_PER_IP_PER_MINUTE=60
TENANT_RATE_LIMIT_PER_MINUTE=1200

# Public signup (POST /tenants). Defaults to on locally and off in
# production, where the team creates each business with
#   node dist/src/cli/provision-tenant.js "<business>" <owner email>
SIGNUP_ENABLED=true

# ============================================================================
# 3. Photo storage — optional
# ============================================================================
# Driver photos (loads, deliveries, bills, chat). Unset UPLOADS_BUCKET: they
# go to UPLOADS_DIR on this machine's disk — fine for testing, lost when a
# hosted container restarts.
#   Get it: AWS console → S3 → Create bucket (private, versioning on). The
#   server's role (or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in its
#   environment) needs s3:GetObject and s3:PutObject on it.
UPLOADS_DIR=./uploads
# UPLOADS_BUCKET=morbeez-uploads
# AWS_REGION=ap-south-1

# ============================================================================
# 4. Outside services — the APIs to sign up for (all optional)
# ============================================================================
#
#   Feature                                   Needs
#   ----------------------------------------  -----------------------------------
#   WhatsApp orders arrive on AI Orders       4a + 4b (VERIFY_TOKEN, APP_SECRET)
#   ...and the customer gets a reply          + 4b ACCESS_TOKEN, and "Reply" on in
#                                               Settings → Integrations
#   Orders read in any language and script    4c (else simple rules read English
#                                               like "Tomato 20 kg")
#   Automated calls from AI Calling           4a + 4d, and "Automated calls" on in
#                                               Settings → Integrations
#
# Meta and Twilio call this API back, so it must be reachable from the
# internet: test on the hosted preview (Render), or locally through a tunnel
# (ngrok, cloudflared) and put the tunnel's https address in PUBLIC_API_URL.

# ---- 4a. This API's public address -----------------------------------------
# The https address the internet reaches this API at, no trailing slash —
# e.g. the Render service's URL. Webhooks are under it:
#   WhatsApp: <PUBLIC_API_URL>/webhooks/whatsapp
#   Twilio:   <PUBLIC_API_URL>/webhooks/twilio/voice/... (set per call; nothing to paste)
# PUBLIC_API_URL=https://your-api.onrender.com

# ---- 4b. WhatsApp Cloud API (Meta) -----------------------------------------
# Customers' order messages to the business's WhatsApp number become order
# suggestions on AI Orders; the owner checks each against the message and
# places it.
#   Get it:
#   1. developers.facebook.com → My Apps → Create app → type "Business" →
#      add the "WhatsApp" product. API Setup gives a test number to start
#      with, or add the business's own number there.
#   2. WHATSAPP_APP_SECRET: App settings → Basic → App secret (Show).
#   3. WHATSAPP_VERIFY_TOKEN: any long random string you make up — the same
#      one goes in Meta's webhook form below.
#   4. WhatsApp → Configuration → Webhook: Callback URL =
#      <PUBLIC_API_URL>/webhooks/whatsapp, Verify token = WHATSAPP_VERIFY_TOKEN,
#      Verify and save; then subscribe to the "messages" field.
#   5. WHATSAPP_ACCESS_TOKEN (only for replies): API Setup's temporary token
#      works for 24 hours; for a lasting one, Business settings → Users →
#      System users → add one, assign the app, Generate token with
#      whatsapp_business_messaging and whatsapp_business_management.
#   6. In the owner app, Settings → Integrations: paste the number's
#      "Phone number ID" (API Setup, under the number — digits only). That,
#      not an environment variable, ties the number to this business.
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_ACCESS_TOKEN=
# The Graph API version the calls use; the app dashboard shows the current one.
# WHATSAPP_API_VERSION=v23.0

# ---- 4c. Claude (Anthropic) ------------------------------------------------
# Reads what was ordered out of a WhatsApp message — Malayalam, Kannada,
# Tamil or English, any script, spelt any way — against the product list.
# It only reads: the owner places every order. Unset, simple rules read
# messages like "Tomato 20 kg, onion 15 kg" and nothing else.
#   Get it: platform.claude.com (Claude Console) → sign in → Settings →
#   API keys → Create key; add credit under Billing.
# ANTHROPIC_API_KEY=sk-ant-...
# The model; unset uses claude-opus-5-5.
# ANTHROPIC_MODEL=claude-opus-5-5

# ---- 4d. Twilio — automated calls -------------------------------------------
# From AI Calling the owner can have a customer called: a payment reminder,
# their usual order for tomorrow, or an order to confirm — spoken in the
# customer's language; they press 1 (yes) or 2 (call me back), and AI Calling
# shows which. Needs PUBLIC_API_URL too.
#   Get it:
#   1. console.twilio.com → sign up. Account Info on the console's front
#      page shows the Account SID (AC...) and Auth Token.
#   2. Phone Numbers → Buy a number with Voice → TWILIO_FROM_NUMBER, in
#      +E.164 form.
#   3. Voice → Settings → Geo permissions: allow India.
#   4. A trial account calls only numbers verified under Phone Numbers →
#      Verified Caller IDs, and plays a trial notice first — verify your own
#      phone to test, upgrade before calling customers.
# TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+10000000000

# ============================================================================
# 5. Testing only — leave unset
# ============================================================================
# The end-to-end suites point these at a local stand-in for each provider
# (testing/e2e/suites/integrations-e2e.js).
# WHATSAPP_API_BASE=
# ANTHROPIC_BASE_URL=
# TWILIO_API_BASE=

# ============================================================================
# 6. The other apps' settings (not read by this file)
# ============================================================================
# Owner app:  apps/owner-app/.env.example — API_BASE_URL, this API's address
#             as the owner app's server reaches it.
# Driver app: apps/driver-app/gradle.properties — morbeez.previewApiUrl and
#             morbeez.previewOwnerUrl, the hosted API and owner app the
#             preview APK talks to (`./gradlew assemblePreview`); or
#             -Pmorbeez.apiUrl=... -Pmorbeez.ownerUrl=... for one build.
