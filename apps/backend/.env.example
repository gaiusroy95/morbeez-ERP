# Copy to .env for local development. Validated at boot by
# src/config/env.validation.ts — the process refuses to start if a required
# variable is missing or malformed, rather than failing confusingly later.

NODE_ENV=development
PORT=3000

# Matches docker-compose's postgres service when running via Docker; point
# at localhost if running the backend directly on the host against
# `docker compose up postgres redis`.
DATABASE_URL=postgres://morbeez:morbeez_dev_only@localhost:5432/morbeez
REDIS_URL=redis://localhost:6379

# Local dev only — a real secret comes from the secrets manager in every
# other environment (Constitution V.3).
JWT_SECRET=dev_only_change_me

# Local event bus (docker-compose does not run one yet — see System
# Architecture, EVT.2, for the target: Amazon MSK Serverless / Kafka
# protocol). Leave unset until that service is added to docker-compose.
EVENT_BUS_BROKERS=

LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:3001
API_DOCS_ENABLED=true
DATABASE_POOL_MAX=10
